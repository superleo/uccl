# Build the DietGPU float codec with the MUSA compiler.
#
# Target environment: Moore Threads S5000/PH100, MUSA mcc, mp_31.
# This is opt-in and does not change the CUDA or ROCm Makefiles.

MUSA_HOME ?= /usr/local/musa
MCC ?= $(MUSA_HOME)/bin/mcc
MUSA_ARCH ?= mp_31
MUSA_LIBDIR ?= $(MUSA_HOME)/lib
MUSA_CXX_INCLUDE ?= /usr/include/c++/11
MUSA_CXX_TARGET_INCLUDE ?= /usr/include/x86_64-linux-gnu/c++/11
MUSA_CXX_BACKWARD_INCLUDE ?= /usr/include/c++/11/backward

DIETGPU_ROOT = ../..
ANS_DIR = $(DIETGPU_ROOT)/dietgpu/ans
UTILS_DIR = $(DIETGPU_ROOT)/dietgpu/utils
FLOAT_DIR = .
UCCL_INCLUDE = $(DIETGPU_ROOT)/../../include

LIB_TARGET = libdietgpu_float_musa.so
OBJ_DIR ?= obj-musa

INCLUDES = -I$(DIETGPU_ROOT) -I$(UCCL_INCLUDE)
MCC_FLAGS = -O3 -std=c++17 -fPIC -DDIETGPU_USE_MUSA
MCC_FLAGS += --offload-arch=$(MUSA_ARCH) $(INCLUDES)
MCC_FLAGS += -I$(MUSA_CXX_INCLUDE) -I$(MUSA_CXX_TARGET_INCLUDE)
MCC_FLAGS += -I$(MUSA_CXX_BACKWARD_INCLUDE)
LDFLAGS = -shared
LDLIBS = -L$(MUSA_LIBDIR) -lmusart -lmusa

UTILS_SRCS = \
	$(UTILS_DIR)/DeviceUtils.cpp \
	$(UTILS_DIR)/StackDeviceMemory.cpp

ANS_SRCS = \
	$(ANS_DIR)/GpuANSDecode.cu \
	$(ANS_DIR)/GpuANSEncode.cu \
	$(ANS_DIR)/GpuANSInfo.cu

FLOAT_SRCS = \
	$(FLOAT_DIR)/GpuFloatCompress.cu \
	$(FLOAT_DIR)/GpuFloatDecompress.cu \
	$(FLOAT_DIR)/GpuFloatInfo.cu

UTILS_OBJS = $(patsubst $(UTILS_DIR)/%.cpp,$(OBJ_DIR)/utils_%.o,$(UTILS_SRCS))
ANS_OBJS = $(patsubst $(ANS_DIR)/%.cu,$(OBJ_DIR)/ans_%.o,$(ANS_SRCS))
FLOAT_OBJS = $(patsubst $(FLOAT_DIR)/%.cu,$(OBJ_DIR)/float_%.o,$(FLOAT_SRCS))
ALL_OBJS = $(UTILS_OBJS) $(ANS_OBJS) $(FLOAT_OBJS)

.PHONY: all clean

all: $(LIB_TARGET)

$(OBJ_DIR):
	mkdir -p $@

$(OBJ_DIR)/utils_%.o: $(UTILS_DIR)/%.cpp | $(OBJ_DIR)
	$(MCC) $(MCC_FLAGS) -c $< -o $@

$(OBJ_DIR)/ans_%.o: $(ANS_DIR)/%.cu | $(OBJ_DIR)
	$(MCC) $(MCC_FLAGS) -c $< -o $@

$(OBJ_DIR)/float_%.o: $(FLOAT_DIR)/%.cu | $(OBJ_DIR)
	$(MCC) $(MCC_FLAGS) -c $< -o $@

$(LIB_TARGET): $(ALL_OBJS)
	$(MCC) $(MCC_FLAGS) $(LDFLAGS) -o $@ $^ $(LDLIBS)

clean:
	rm -rf $(OBJ_DIR) $(LIB_TARGET)
